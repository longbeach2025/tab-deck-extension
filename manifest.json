{
  "manifest_version": 3,
  "name": "Tab Deck",
  "description": "Cloud-synced tab sessions, spaces, collections, notes, and quick restore.",
  "version": "0.2.21",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://*.supabase.co/*", "https://api.openai.com/*", "https://api.minimax.io/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tab Deck",
    "default_popup": "popup.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
