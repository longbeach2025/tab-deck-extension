{
  "name": "tab-deck-extension",
  "version": "0.2.0-alpha.27",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "package": "./scripts/package_release.sh",
    "check": "node --check src/storage.js && node --check src/cloud.js && node --check src/app.js && node --check src/popup.js && node --check src/background.js && node --check scripts/health_check.mjs && python3 -m json.tool manifest.json",
    "preprocess:toby:deepseek": "node scripts/toby_preprocess_deepseek.mjs",
    "embed:preprocessed:local": "python3 scripts/generate_embeddings_local_bge_m3.py",
    "embed:preprocessed": "node scripts/generate_embeddings_from_preprocessed.mjs",
    "import:preprocessed:supabase": "node scripts/import_preprocessed_to_supabase.mjs",
    "export:init:supabase": "node scripts/export_init_bundle_from_supabase.mjs",
    "import:init:supabase": "node scripts/import_init_bundle_to_supabase.mjs",
    "health-check": "node scripts/health_check.mjs",
    "dev:seed": "node scripts/dev_data.mjs seed",
    "dev:reset": "node scripts/dev_data.mjs reset",
    "dev:capture-seed": "node scripts/dev_data.mjs capture-seed",
    "dev:unbind-machine": "node scripts/dev_machine_unbind.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.87.0"
  },
  "devDependencies": {
    "vite": "^7.3.0"
  }
}
